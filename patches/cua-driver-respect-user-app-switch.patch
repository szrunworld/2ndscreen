+/// How recently real input must precede an activation for it to count as
+/// user-initiated. `CUA_DRIVER_USER_SWITCH_WINDOW_MS` overrides the 800ms
+/// default; `0` disables the check and restores every match as before.
+fn user_switch_window() -> Option<Duration> {
+    static WINDOW: OnceLock<Option<Duration>> = OnceLock::new();
+    *WINDOW.get_or_init(|| {
+        let ms = std::env::var("CUA_DRIVER_USER_SWITCH_WINDOW_MS")
+            .ok()
+            .and_then(|v| v.trim().parse::<u64>().ok())
+            .unwrap_or(800);
+        (ms > 0).then(|| Duration::from_millis(ms))
+    })
+}
+
+fn is_user_initiated(window: Option<Duration>) -> bool {
+    window.is_some_and(|w| seconds_since_switch_input() <= w.as_secs_f64())
+}
+
+/// Seconds since the last hardware input that can switch apps: a modifier
+/// change (Cmd-Tab, Cmd-Space) or a mouse button. Plain key-downs are left
+/// out so typing in the current app does not disarm steal protection.
+fn seconds_since_switch_input() -> f64 {
+    #[link(name = "CoreGraphics", kind = "framework")]
+    extern "C" {
+        fn CGEventSourceSecondsSinceLastEventType(state: i32, event_type: u32) -> f64;
+    }
+    const HID_SYSTEM_STATE: i32 = 1;
+    // kCGEventLeftMouseDown, LeftMouseUp, RightMouseDown, OtherMouseDown,
+    // FlagsChanged.
+    const SWITCH_EVENT_TYPES: [u32; 5] = [1, 2, 3, 25, 12];
+    SWITCH_EVENT_TYPES
+        .iter()
+        .map(|&t| unsafe { CGEventSourceSecondsSinceLastEventType(HID_SYSTEM_STATE, t) })
+        .fold(f64::INFINITY, f64::min)
+}
