+    /// Adopt a user-initiated activation of `activated_pid` instead of
+    /// fighting it.
+    ///
+    /// The user's choice becomes every live entry's new `restore_to`, so a
+    /// later self-activation is pushed back to where the user went rather
+    /// than to the app they left. An entry targeting `activated_pid` itself
+    /// expires: the user asked for that app, so it is no longer a steal.
+    fn adopt_user_activation(&self, activated_pid: i32) {
+        let mut guard = self.entries.lock().unwrap();
+        let now = Instant::now();
+        guard.retain(|_, e| e.deadline > now && e.target_pid != Some(activated_pid));
+        for entry in guard.values_mut() {
+            entry.restore_to = activated_pid;
+        }
+    }
+
