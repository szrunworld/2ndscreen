+    // A suppression entry cannot tell an app's self-activation from the
+    // user's own Cmd-Tab, Dock click, or window click. Real input is the
+    // discriminator: the driver's synthetic events are posted to a pid and do
+    // not update the HID system state, so recent hardware input means the
+    // user chose this app.
+    if is_user_initiated(user_switch_window()) {
+        dispatcher.adopt_user_activation(activated_pid);
