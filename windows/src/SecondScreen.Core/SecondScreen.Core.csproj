<Project Sdk="Microsoft.NET.Sdk">
  <!-- Protocol, pure logic and Win32 declarations. Plain net8.0 so the logic
       tests also run on macOS; the Win32 calls only work on Windows. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SecondScreen</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
