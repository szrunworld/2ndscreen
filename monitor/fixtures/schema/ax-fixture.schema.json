{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ax_fixture",
  "description": "脱敏元素树夹具格式（monitor/fixtures/ax/<scene>/fixture.json）。一个夹具是一个场景的若干步，每步是一次 Driver.state() 的扁平元素列表加人工标注。候选人姓名替换为'候选人A/B…'，手机号与微信号删除。本文件自包含，不引用 contracts/schemas。",
  "type": "object",
  "required": [
    "fixture_version",
    "scene",
    "description",
    "recorded_at",
    "source",
    "redaction",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "fixture_version": {
      "const": 1
    },
    "scene": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]{0,63}$",
      "description": "场景名，与目录名一致，如 conversation_list_new_application。"
    },
    "description": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "required": [
        "app",
        "driver"
      ],
      "additionalProperties": false,
      "properties": {
        "app": {
          "type": "string",
          "minLength": 1
        },
        "app_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "driver": {
          "type": "string",
          "minLength": 1,
          "description": "录制所用驱动，如 2ndscreen-cli 0.x。"
        },
        "recorded_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "redaction": {
      "type": "object",
      "description": "脱敏声明，三项必须都为 true；监督者抽查。",
      "required": [
        "names_replaced",
        "phones_removed",
        "wechat_removed"
      ],
      "additionalProperties": false,
      "properties": {
        "names_replaced": {
          "const": true
        },
        "phones_removed": {
          "const": true
        },
        "wechat_removed": {
          "const": true
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "minimum": 0
        },
        "h": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "redacted_text": {
      "type": "string",
      "description": "元素文本。不得含中国大陆手机号样式的 11 位数字。",
      "not": {
        "pattern": "1[3-9][0-9]{9}"
      },
      "x-message": "疑似手机号，夹具必须脱敏"
    },
    "element": {
      "type": "object",
      "description": "与 monitor_contracts.Element 相同（省略 snapshot_id）：index 等于在 elements 中的位置；include_tree 录制时可带 parent_index / depth。",
      "required": [
        "index",
        "role",
        "label",
        "value",
        "frame"
      ],
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "label": {
          "$ref": "#/$defs/redacted_text"
        },
        "value": {
          "$ref": "#/$defs/redacted_text"
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "null 或省略 = 来源不提供（2ndscreen CLI 不输出 enabled）"
        },
        "parent_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "depth": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "window": {
      "type": "object",
      "required": [
        "window_id",
        "frame"
      ],
      "additionalProperties": false,
      "properties": {
        "pid": {
          "type": [
            "integer",
            "null"
          ]
        },
        "window_id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "title": {
          "$ref": "#/$defs/redacted_text"
        },
        "app_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "conversation": {
      "type": "object",
      "required": [
        "candidate_name",
        "job_title"
      ],
      "additionalProperties": false,
      "properties": {
        "candidate_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "job_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 10
        }
      }
    },
    "annotations": {
      "type": "object",
      "description": "人工标注，是观察与动作测试的期望值。扩展键必须以 x_ 开头。",
      "required": [
        "page"
      ],
      "properties": {
        "page": {
          "type": "string",
          "enum": [
            "conversation_list",
            "conversation_detail",
            "search",
            "login",
            "login_qr",
            "captcha",
            "unknown_dialog",
            "resume_overlay",
            "other"
          ]
        },
        "conversations": {
          "type": "array",
          "description": "本步可见会话的标注。",
          "items": {
            "type": "object",
            "required": [
              "element_index",
              "conversation",
              "is_new_application"
            ],
            "additionalProperties": false,
            "properties": {
              "element_index": {
                "type": "integer",
                "minimum": 0
              },
              "conversation": {
                "$ref": "#/$defs/conversation"
              },
              "is_new_application": {
                "type": "boolean"
              },
              "unread": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "ambiguous": {
                "type": "boolean"
              }
            }
          }
        },
        "is_new_application": {
          "type": "array",
          "description": "被标注为'新投递'的会话元素 index 列表（简写；详细信息放 conversations）。",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "qr_region": {
          "oneOf": [
            {
              "$ref": "#/$defs/frame"
            },
            {
              "type": "null"
            }
          ],
          "description": "登录二维码所在区域（屏幕坐标）。"
        },
        "expected_events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "观察本步后应产生的事件 kind 列表（空 = 不应产生事件）。"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "patternProperties": {
        "^x_": {}
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "label",
        "window",
        "elements",
        "annotations"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "window": {
          "oneOf": [
            {
              "$ref": "#/$defs/window"
            },
            {
              "type": "null"
            }
          ]
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "annotations": {
          "$ref": "#/$defs/annotations"
        }
      }
    }
  }
}
