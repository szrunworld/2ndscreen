{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mail_message",
  "description": "公司邮箱 zhaopin@remotedesk.io 里的一封邮件在我方的记录（方案 8.2）。Monitor 不直接接 Resend，而是公司邮件服务 mail（amplifistudio/remotedesk-resend）的订阅方：收到 mail.ready webhook 即以 status=pending 写入（PUT /mail-messages/{mail_message_id}，此时只有标识），再用 mail 的 integration API key 回取邮件与附件、写我方副本，之后按 monitor_contracts.states.MAIL_TRANSITIONS 更新状态。Monitor 不删除 mail 里的邮件；我方副本按 policy.mail_retention_days 清理，只留元数据。",
  "type": "object",
  "required": [
    "mail_message_id",
    "provider",
    "provider_message_id",
    "mailbox",
    "message_id",
    "received_at",
    "sha256",
    "status",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "mail_message_id": {
      "type": "string",
      "pattern": "^mail:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "记录主键 = 'mail:' + provider_message_id（小写 UUID），由 compute_mail_message_id 生成。"
    },
    "provider": {
      "type": "string",
      "enum": [
        "remotedesk-mail"
      ],
      "description": "邮件来源：公司邮件服务 mail。"
    },
    "provider_message_id": {
      "$ref": "common.json#/$defs/uuid",
      "description": "mail 的 message_id（mail.ready 推送体里的 message_id），回取邮件用 GET /v1/integration/messages/{id}。"
    },
    "webhook_delivery_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128,
      "default": null,
      "description": "首次收到的 mail.ready 投递 id（推送体 id），用于和 mail 的 webhook 投递台账对账。"
    },
    "mailbox": {
      "type": "string",
      "format": "email",
      "maxLength": 254,
      "description": "收件邮箱（zhaopin@remotedesk.io）。"
    },
    "message_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 998,
      "description": "邮件头 Message-ID 原文，只用于展示与排查，不参与主键；推送阶段未知或邮件缺失时为 null。"
    },
    "received_at": {
      "$ref": "common.json#/$defs/timestamp",
      "description": "mail 收到邮件的时间（推送体 occurred_at 或回取结果）。"
    },
    "sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "我方副本（原始邮件）的 sha256；回取前为 null。processed / needs_review 时必填。只用于核对，不是候选人身份。"
    },
    "raw_storage_uri": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 1024,
      "default": null,
      "description": "我方副本的存储位置；副本按保留期清理后为 null。"
    },
    "copy_purged_at": {
      "oneOf": [
        {
          "$ref": "common.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "我方副本按 policy.mail_retention_days 清理的时间；非空时 raw_storage_uri 必须为 null。"
    },
    "from_address": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 254,
      "default": null
    },
    "subject": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500,
      "default": null
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processed",
        "needs_review",
        "failed",
        "ignored"
      ],
      "description": "我方处理状态（不对应 mail 里的文件夹，Monitor 不移动、不删除 mail 里的邮件）：pending 已登记待消费；processed 已提交；needs_review 关联歧义或找不到流程；failed 连续失败达到上限；ignored 非 BOSS 发件人。"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "消费失败次数。"
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500,
      "default": null,
      "description": "failed 必填；pending 可记最近一次失败原因；needs_review / ignored 可写原因；processed 必须为 null。"
    },
    "updated_at": {
      "$ref": "common.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "x-message": "status=failed 时必须给出 error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "processed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "null",
            "x-message": "status=processed 时 error 必须为 null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "processed",
              "needs_review"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "sha256": {
            "type": "string",
            "x-message": "processed / needs_review 时必须已有我方副本的 sha256"
          }
        }
      }
    }
  ]
}
