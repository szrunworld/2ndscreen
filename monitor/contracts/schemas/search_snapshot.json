{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "search_snapshot",
  "description": "search_candidates 读取当前页得到的快照。三种结局必须可区分：确认无结果 empty_confirmed、成功读取 partial|complete、无法读取 unreadable。读取失败不得表示为空列表。Monitor 只回答有/没有，并原样返回每张结果卡片上界面已有的可读文本；不识别候选人身份。",
  "type": "object",
  "required": [
    "search_id",
    "query",
    "scope",
    "coverage",
    "items",
    "captured_at"
  ],
  "additionalProperties": false,
  "properties": {
    "search_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "scope": {
      "const": "current_page",
      "description": "第一版只读当前页，不翻页。"
    },
    "coverage": {
      "type": "string",
      "enum": [
        "partial",
        "complete",
        "unreadable",
        "empty_confirmed"
      ],
      "description": "partial 当前页部分可读；complete 当前页全部可读；unreadable 无法读取；empty_confirmed 界面明确显示无结果。"
    },
    "unreadable_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 200,
      "description": "coverage=unreadable 时必填：为什么读不到（如 results_are_image、state_unrecognized）。"
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "result_ref",
          "position",
          "fields",
          "prop_card_texts"
        ],
        "additionalProperties": false,
        "properties": {
          "result_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}:item_[1-9][0-9]*$",
            "description": "本次快照内的位置引用，格式 <search_id>:item_<position>。不是候选人身份，也不能作为任何指令的目标。"
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "卡片在当前页结果中的顺序（从 1 起，自上而下）；必须等于 result_ref 末尾的序号。"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "items": {
              "$ref": "#/$defs/card_field"
            },
            "description": "卡片上界面已有的全部可读文本，按出现顺序原样给出（学历、院校、经验、年龄、标签、期望、活跃状态等）。不做归类、不做推断。"
          },
          "masked_name": {
            "oneOf": [
              {
                "$ref": "#/$defs/card_text",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "卡片上平台打码后的姓名原文（如「王**」）；读不到时为 null。不是身份。"
          },
          "prop_card_texts": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/card_text",
              "maxLength": 200
            },
            "description": "卡片上与道具卡相关的元素文案，原样给出；没有时为空数组。Monitor 不点击、不使用道具卡。"
          }
        }
      }
    },
    "captured_at": {
      "$ref": "common.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage": {
            "const": "unreadable"
          }
        },
        "required": [
          "coverage"
        ]
      },
      "then": {
        "required": [
          "unreadable_reason"
        ],
        "properties": {
          "items": {
            "maxItems": 0,
            "x-message": "coverage 为 unreadable / empty_confirmed 时 items 必须为空"
          },
          "unreadable_reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage": {
            "const": "empty_confirmed"
          }
        },
        "required": [
          "coverage"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "maxItems": 0,
            "x-message": "coverage 为 unreadable / empty_confirmed 时 items 必须为空"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage": {
            "enum": [
              "partial",
              "complete"
            ]
          }
        },
        "required": [
          "coverage"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "minItems": 1,
            "x-message": "coverage 为 partial / complete 时至少一条；确认无结果应为 empty_confirmed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage": {
            "not": {
              "const": "unreadable"
            }
          }
        },
        "required": [
          "coverage"
        ]
      },
      "then": {
        "properties": {
          "unreadable_reason": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "card_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "not": {
        "pattern": "1[3-9][0-9]{9}"
      },
      "x-message": "疑似手机号：搜索快照只放卡片上的可读文本，不得含联系方式",
      "description": "卡片文本原文。不得含中国大陆手机号样式的 11 位数字。"
    },
    "card_field": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64,
          "default": null,
          "description": "界面上该文本旁可见的标签（如有）；界面没有标签时为 null，不要自行命名。"
        },
        "text": {
          "$ref": "#/$defs/card_text"
        }
      }
    }
  }
}
