{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mail_verification",
  "description": "邮箱核对任务的一次结果（方案 8.2 第 5 条），由邮件接入（G）定时提交（POST /mail-verifications）。outcome 只反映邮箱完整性检查；求简历超时提醒单列在 overdue_resume_requests，不影响 outcome。",
  "type": "object",
  "required": [
    "verification_id",
    "mailbox",
    "started_at",
    "finished_at",
    "outcome",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "verification_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$",
      "description": "本次核对的标识，同时用作 Idempotency-Key。"
    },
    "mailbox": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "started_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ok",
        "issues_found",
        "failed"
      ],
      "description": "ok 已执行的检查项 count 都为 0（未执行的项不算问题）；issues_found 至少一项 count>0；failed 核对本身没跑完（必须给出 error）。"
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500,
      "default": null
    },
    "checks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "code",
          "count"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "pending_backlog",
              "copy_missing",
              "hash_mismatch",
              "document_without_copy",
              "needs_review_mismatch",
              "failed_mismatch",
              "webhook_delivery_failed",
              "upstream_missing"
            ],
            "description": "pending_backlog pending 超过 30 分钟；copy_missing 我方副本不存在（已按保留期清理的不算）；hash_mismatch 副本哈希不一致；document_without_copy resume_document 找不到副本；needs_review_mismatch / failed_mismatch 与人工队列不一致；webhook_delivery_failed mail 投递台账里失败或落死的 mail.ready 投递；upstream_missing mail 里有、我方没有的邮件（需要 mail 提供列出邮件的接口，见任务 G0；没有时 count=null 并写 unavailable_reason）。"
          },
          "count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "null 表示本次没能执行该检查，此时必须给出 unavailable_reason。"
          },
          "refs": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "default": [],
            "description": "抽样的 mail_message_id 或 doc_id，便于控制台跳转。"
          },
          "unavailable_reason": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200,
            "default": null
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "count": {
                  "type": "null"
                }
              },
              "required": [
                "count"
              ]
            },
            "then": {
              "required": [
                "unavailable_reason"
              ],
              "properties": {
                "unavailable_reason": {
                  "type": "string",
                  "x-message": "count 为 null 时必须给出 unavailable_reason"
                }
              }
            },
            "else": {
              "properties": {
                "unavailable_reason": {
                  "type": "null",
                  "x-message": "执行了的检查项不能带 unavailable_reason"
                }
              }
            }
          }
        ]
      },
      "description": "outcome 为 ok / issues_found 时必须包含全部 8 个检查项，各一次。"
    },
    "overdue_resume_requests": {
      "type": "array",
      "maxItems": 200,
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "command_id",
          "requested_at",
          "days_waiting"
        ],
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "$ref": "common.json#/$defs/workflow_id"
          },
          "command_id": {
            "$ref": "common.json#/$defs/uuid",
            "description": "成功的 request_resume 指令。"
          },
          "requested_at": {
            "$ref": "common.json#/$defs/timestamp"
          },
          "days_waiting": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "description": "求简历成功但超过 policy.resume_mail_timeout_days 仍未收到邮件的流程（提醒）。"
    },
    "purged_copies": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "本次按 policy.mail_retention_days 清理的我方副本数量。只删我方副本，不删 mail 里的邮件。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "failed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "x-message": "outcome=failed 时必须给出 error"
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "null",
            "x-message": "只有 outcome=failed 时才能填写 error"
          }
        }
      }
    }
  ]
}
