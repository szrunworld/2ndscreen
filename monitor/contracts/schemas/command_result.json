{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "command_result",
  "description": "Monitor → 服务端的指令结果。同一 command_id 只有一个最终结果；重复回报必须与首次一致。",
  "type": "object",
  "required": [
    "command_id",
    "action",
    "status",
    "reason",
    "observed",
    "evidence",
    "navigation_performed",
    "outbound_action_performed",
    "externally_visible_side_effect",
    "executed_at",
    "reported_at"
  ],
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "$ref": "common.json#/$defs/uuid"
    },
    "action": {
      "$ref": "common.json#/$defs/action"
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "execute",
        "verify_only"
      ],
      "default": "execute"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "expired",
        "skipped_precondition",
        "unknown"
      ]
    },
    "reason": {
      "oneOf": [
        {
          "$ref": "#/$defs/reason"
        },
        {
          "type": "null"
        }
      ],
      "description": "status 为 failed / unknown / skipped_precondition 时必填；succeeded 时必须为 null。"
    },
    "reason_detail": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500,
      "description": "给人看的补充说明（脱敏）。"
    },
    "observed": {
      "$ref": "common.json#/$defs/observed"
    },
    "evidence": {
      "$ref": "common.json#/$defs/evidence"
    },
    "navigation_performed": {
      "type": "boolean",
      "description": "本次执行是否发生过导航类 GUI 操作：点击打开会话、切换页签/筛选、滚动、关闭弹层等只改变本机界面的操作。verify_only 允许为 true。"
    },
    "outbound_action_performed": {
      "type": "boolean",
      "description": "本次执行是否发生过对候选人或第三方可见的动作：发送消息、点击确认、提交转发、点击求简历/换电话等。verify_only 时必须为 false；为 true 时 externally_visible_side_effect 必须为 true。"
    },
    "externally_visible_side_effect": {
      "type": "boolean",
      "description": "本次执行是否可能产生了对方可见的副作用。对外动作一定算；没有对外动作也可能为 true，例如打开未读会话产生已读回执。"
    },
    "executed_at": {
      "oneOf": [
        {
          "$ref": "common.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ],
      "description": "开始执行（读取界面）的时间；cancelled / expired 时必须为 null；succeeded 时必填。"
    },
    "reported_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "output": {
      "oneOf": [
        {
          "$ref": "#/$defs/search_output"
        },
        {
          "$ref": "#/$defs/contact_output"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "动作特有的输出，形状由 action 决定。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "type": "null"
          },
          "executed_at": {
            "$ref": "common.json#/$defs/timestamp"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "failed",
              "unknown",
              "skipped_precondition"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "executed_at": {
            "type": "null"
          },
          "outbound_action_performed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "expired"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "executed_at": {
            "type": "null"
          },
          "navigation_performed": {
            "const": false
          },
          "outbound_action_performed": {
            "const": false
          },
          "externally_visible_side_effect": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "verify_only"
          }
        },
        "required": [
          "execution_mode"
        ]
      },
      "then": {
        "properties": {
          "outbound_action_performed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outbound_action_performed": {
            "const": true
          }
        },
        "required": [
          "outbound_action_performed"
        ]
      },
      "then": {
        "properties": {
          "externally_visible_side_effect": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "search_candidates"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "output": {
            "oneOf": [
              {
                "$ref": "#/$defs/search_output"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "search_candidates"
          },
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "action",
          "status"
        ]
      },
      "then": {
        "required": [
          "output"
        ],
        "properties": {
          "output": {
            "$ref": "#/$defs/search_output",
            "properties": {
              "snapshot": {
                "properties": {
                  "coverage": {
                    "enum": [
                      "partial",
                      "complete",
                      "empty_confirmed"
                    ],
                    "x-message": "无法读取的快照不能回报为 succeeded；应为 status=failed, reason=unreadable"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "request_contact_exchange"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "output": {
            "oneOf": [
              {
                "$ref": "#/$defs/contact_output"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "request_contact_exchange"
          },
          "status": {
            "enum": [
              "succeeded",
              "skipped_precondition"
            ]
          }
        },
        "required": [
          "action",
          "status"
        ]
      },
      "then": {
        "required": [
          "output"
        ],
        "properties": {
          "output": {
            "$ref": "#/$defs/contact_output"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "send_greeting",
              "request_resume",
              "provide_input"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "output": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "reason": {
      "type": "string",
      "enum": [
        "action_not_allowed",
        "rate_limited",
        "target_ambiguous",
        "target_not_found",
        "unknown_dialog",
        "login_required",
        "captcha",
        "account_mismatch",
        "paused",
        "dependency_not_satisfied",
        "timeout",
        "unreadable",
        "unsupported",
        "precondition_already_done",
        "verification_failed",
        "driver_error",
        "crash_recovery"
      ],
      "description": "结果原因分类，含义见 docs/monitor/contracts.md。"
    },
    "search_output": {
      "type": "object",
      "required": [
        "snapshot"
      ],
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "$ref": "search_snapshot.json"
        }
      }
    },
    "contact_output": {
      "type": "object",
      "required": [
        "exchange_type",
        "exchange_state"
      ],
      "additionalProperties": false,
      "properties": {
        "exchange_type": {
          "$ref": "common.json#/$defs/exchange_type"
        },
        "exchange_state": {
          "$ref": "common.json#/$defs/exchange_state"
        }
      }
    }
  }
}
