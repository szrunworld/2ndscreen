{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy",
  "description": "账户级策略。服务端保存与下发；Monitor 本地另有写死的硬上限与最小间隔下限，策略只能收紧、不能放宽。",
  "type": "object",
  "required": [
    "account_id",
    "policy_version",
    "allowed_actions",
    "job_scope",
    "greeting",
    "auto_request_resume",
    "after_resume_received",
    "resume_mail_timeout_days",
    "company_mailbox",
    "mail_retention_days",
    "work_hours",
    "daily_limits",
    "min_interval_seconds",
    "pause_on_anomaly",
    "paused",
    "updated_at",
    "updated_by"
  ],
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "$ref": "common.json#/$defs/account_id"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1,
      "description": "每次修改 +1；PUT 时用 If-Match 做乐观锁。"
    },
    "allowed_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "send_greeting",
          "request_resume",
          "request_contact_exchange",
          "search_candidates"
        ]
      },
      "default": [],
      "description": "对外动作白名单，默认空 = 全部关闭。provide_input 与 verify_only 不受白名单控制。"
    },
    "job_scope": {
      "type": "object",
      "required": [
        "mode",
        "job_titles"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "all",
            "listed"
          ]
        },
        "job_titles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 200,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "listed"
              }
            }
          },
          "then": {
            "properties": {
              "job_titles": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "greeting": {
      "type": "object",
      "required": [
        "enabled",
        "template"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "template": {
          "type": "string",
          "maxLength": 500,
          "description": "问候模板，可用占位符 {candidate_name}、{job_title}。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "template": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "auto_request_resume": {
      "type": "boolean"
    },
    "after_resume_received": {
      "type": "object",
      "required": [
        "action",
        "wait_for_parse"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "none"
          ],
          "default": "none",
          "description": "简历关联后的自动动作。0.3.0 起只能是 none：交换联系方式（换微信）只能由人工在控制台触发（POST /cases/{case_id}:request-wechat），服务端不得在任何自动流程中生成 request_contact_exchange。"
        },
        "wait_for_parse": {
          "type": "boolean",
          "description": "保留字段，当前没有自动后续动作，不起作用。",
          "default": true
        }
      },
      "default": {
        "action": "none",
        "wait_for_parse": true
      },
      "description": "保留对象以便以后扩展；0.3.0 起不产生任何自动动作。"
    },
    "resume_mail_timeout_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "default": 3,
      "description": "求简历成功后超过该天数仍未收到并关联简历邮件，流程进入 needs_human（超时提醒）。默认 3。"
    },
    "company_mailbox": {
      "oneOf": [
        {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "readOnly": true,
      "description": "公司收件邮箱（zhaopin@remotedesk.io，mail 服务里的公共邮箱；BOSS 账户设置里预留的就是它，候选人同意后 BOSS 把附件简历自动发到这里）。只读展示：以服务端配置为准，PUT 时忽略请求中的值；未配置为 null。"
    },
    "mail_retention_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365,
      "default": 30,
      "description": "我方邮件副本的保留天数（默认 30）：到期由我方清理任务删除副本、只留元数据。Monitor 不删除 mail 服务里的邮件；mail 里的邮件只由 mail 的留存任务销毁（受 legal hold 约束），zhaopin@ 在 mail 侧设 retention_days=30。"
    },
    "work_hours": {
      "type": "object",
      "required": [
        "timezone",
        "windows"
      ],
      "additionalProperties": false,
      "description": "工作时段。服务端只在窗口内生成对外动作指令：send_greeting、request_resume、search_candidates（0.3.2 起搜索算对外动作），窗口外不生成；人工换微信在窗口外顺延到下一窗口开始（command.issued_at）。空窗口表示任何时段都不生成对外指令。provide_input 与 verify_only 不受它约束。",
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "IANA 时区名，如 Asia/Shanghai。"
        },
        "windows": {
          "type": "array",
          "maxItems": 14,
          "items": {
            "type": "object",
            "required": [
              "days",
              "start",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "days": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                },
                "minItems": 1,
                "uniqueItems": true,
                "description": "ISO 星期，1=周一。"
              },
              "start": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "end": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          },
          "description": "空数组 = 任何时段都不生成对外指令。"
        }
      }
    },
    "daily_limits": {
      "$ref": "#/$defs/per_action_counts"
    },
    "min_interval_seconds": {
      "$ref": "#/$defs/per_action_counts"
    },
    "pause_on_anomaly": {
      "const": true,
      "description": "异常时暂停并通知，不可关闭。",
      "x-message": "异常时暂停并通知不可关闭，必须为 true"
    },
    "paused": {
      "type": "boolean"
    },
    "updated_at": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "updated_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "$defs": {
    "per_action_counts": {
      "type": "object",
      "required": [
        "send_greeting",
        "request_resume",
        "request_contact_exchange",
        "search_candidates"
      ],
      "additionalProperties": false,
      "properties": {
        "send_greeting": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "request_resume": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "request_contact_exchange": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "search_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      }
    }
  }
}
